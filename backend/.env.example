PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/novelhub
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@novelhub.com
ADMIN_PASSWORD=ChangeMe123!

# --- Superadmin -----------------------------------------------------------
# The owner account: sees the entire admin portal, reads paid content without
# spending, and is the only role that can decide which modules an admin sees.
# Created or promoted by `npm run seed:superadmin`. Keep the number of these
# accounts small — each one can see and change everything, including the others.
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Apex NovelHub <no-reply@novelhub.com>"
MAIL_BRAND="Apex NovelHub"
OTP_TTL_MINUTES=10

# --- File storage (S3) ---
# Leave S3_BUCKET and AWS_REGION empty to fall back to local-disk storage
# (public images -> ./uploads, private chapter files not archived). Dev only.
AWS_REGION=
S3_BUCKET=
# Credentials: omit both to use an IAM role / the default AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional CDN / custom domain for PUBLIC assets (no trailing slash).
# Defaults to https://<bucket>.s3.<region>.amazonaws.com
S3_PUBLIC_BASE_URL=
# Key prefixes for the two visibility tiers within the bucket.
S3_PUBLIC_PREFIX=public
S3_PRIVATE_PREFIX=private
# Set to true ONLY if your bucket has ACLs enabled and you want per-object
# public-read ACLs. Leave false for modern "Bucket owner enforced" buckets and
# grant public read via the bucket policy below instead.
S3_USE_ACL=false
# Lifetime (seconds) of presigned download URLs for private chapter source files.
S3_SIGNED_URL_TTL=3600
#
# Required bucket policy to make ONLY the public prefix world-readable
# (replace YOUR_BUCKET; keep the private prefix private):
# {
#   "Version": "2012-10-17",
#   "Statement": [{
#     "Sid": "PublicReadForPublicPrefix",
#     "Effect": "Allow",
#     "Principal": "*",
#     "Action": "s3:GetObject",
#     "Resource": "arn:aws:s3:::YOUR_BUCKET/public/*"
#   }]
# }

# --- Monetization ---
# Master switch; also togglable from the admin portal.
MONETIZATION_ENABLED=false
# Multi-document transactions require a replica set. This deployment runs a
# standalone mongod, so they are unavailable — the credit service is designed
# not to need them. Do not set this true without a replica set.
TRANSACTIONS_ENABLED=false
# Set false to run scheduled jobs in a dedicated worker process instead.
SCHEDULER_ENABLED=true

# --- PayPal ---
# Sandbox vs live is an admin setting (Settings -> Payments -> Environment),
# not an env var, so switching does not need a redeploy.
#
# The client ID may be set here or in the admin portal; this wins if both are
# present. The secret and webhook ID are server-only and must live here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# From the webhook you create in the PayPal dashboard. Without it every webhook
# is rejected as unverified, and a buyer who closes the tab mid-payment never
# gets their credits.
PAYPAL_WEBHOOK_ID=
# Only for pointing at a mock server in tests. Leave unset in real use.
# PAYPAL_API_BASE=

# --- Exchange rates ---
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD

# --- Geo detection ---
# Header carrying the reader's country. Cloudflare sets CF-IPCountry.
GEO_HEADER=CF-IPCountry
